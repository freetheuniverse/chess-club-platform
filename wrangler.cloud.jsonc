{
  "name": "chess-club-platform",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chess-club-db",
      "database_id": "cb237797-d2c9-42ed-8b74-f402487bcbff",
      "migrations_dir": "db/migrations"
    }
  ]
}
